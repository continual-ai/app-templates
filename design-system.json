{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "continual-app-templates-design-system",
  "version": "2026-08-11",
  "sourceOfTruth": {
    "tokens": "shared/styles/tokens.css",
    "primitives": "shared/react/components/ui",
    "blocks": "blocks/react",
    "canonicalTemplates": ["templates/tanstack-start-app"],
    "materializedTemplates": ["templates/tanstack-start-app"],
    "syncCommand": "pnpm design-system:sync"
  },
  "stack": {
    "tanstackStartApp": ["TanStack Start", "React", "TypeScript", "Tailwind v4", "shadcn/ui"],
    "charts": ["recharts", "src/components/ui/chart.tsx"]
  },
  "rules": [
    "Prefer shadcn primitives from src/components/ui before custom controls.",
    "Use blocks/react as the canonical shared block format.",
    "Do not introduce raw UI colors; use Tailwind utilities backed by the canonical semantic token asset.",
    "Use the provided design system before adding components or custom control styles.",
    "Do not install an unrelated UI or component library unless the user explicitly requests it.",
    "Use Spectrum or Continual brand colors only as optional accents for diagrams, fields, charts, and small highlights; semantic tokens own product controls.",
    "Use lucide icons for icon buttons and navigation.",
    "Keep app surfaces dense, scannable, and workflow-oriented.",
    "For dashboards, internal tools, CRUD, queues, settings, data browsers, and chat surfaces, do not start with a marketing hero.",
    "Use compact page headers for app surfaces: text-2xl or smaller, tight supporting copy, and actions aligned to the right.",
    "Keep custom app wrappers at rounded-lg or smaller; use larger radii only when inherited from shadcn primitives.",
    "Avoid hero-scale app spacing such as py-20, py-24, min-h-screen, or centered landing-page composition."
  ],
  "visualGuardrails": {
    "appSurfaces": {
      "preferred": [
        "PageHeader",
        "FilterBar",
        "MetricCard",
        "ChartCard",
        "DataTable",
        "EmptyState",
        "SettingsForm",
        "ChatShell",
        "shadcn primitives"
      ],
      "avoid": [
        "marketing hero sections",
        "oversized display headings",
        "decorative card stacks",
        "card-in-card layouts",
        "large pill-shaped surfaces",
        "one-note gradient or orb decoration",
        "large page-level vertical padding"
      ],
      "blockedClassPatterns": [
        "rounded-2xl",
        "rounded-3xl",
        "rounded-4xl",
        "rounded-full",
        "text-4xl",
        "text-5xl",
        "text-6xl",
        "py-20",
        "py-24",
        "py-32",
        "min-h-screen",
        "h-screen"
      ],
      "checkCommand": "pnpm check:visual-drift"
    }
  },
  "tokens": {
    "source": "shared/styles/tokens.css",
    "entries": { "tanstackStartApp": "src/styles/global.css" },
    "colors": [
      "background",
      "foreground",
      "card",
      "popover",
      "primary",
      "secondary",
      "muted",
      "accent",
      "destructive",
      "border",
      "input",
      "ring",
      "chart-1",
      "chart-2",
      "chart-3",
      "chart-4",
      "chart-5",
      "sidebar"
    ],
    "themeModes": ["light", "dark"],
    "radius": ["sm", "md", "lg", "xl", "2xl", "3xl", "4xl"],
    "fonts": ["font-sans", "font-heading", "font-mono"]
  },
  "componentTheming": {
    "principle": "A custom theme may change both semantic tokens and the owned shadcn primitive recipes; do not stop at color swaps when the requested direction changes component treatment.",
    "canonicalSource": "shared/react/components/ui",
    "generatedAppOwnership": "Each generated App owns its materialized primitive files and may customize them without adding another component library.",
    "customizable": [
      "control height and density",
      "padding and spacing",
      "corner shape and radius",
      "border weight and treatment",
      "surface elevation and shadows",
      "component typography",
      "state transitions and motion"
    ],
    "preserve": [
      "semantic token utilities",
      "data-slot hooks",
      "ARIA and data-state selectors",
      "keyboard behavior",
      "visible focus states",
      "contrast"
    ]
  },
  "primitives": [
    "attachment",
    "avatar",
    "badge",
    "bubble",
    "button",
    "card",
    "chart",
    "checkbox",
    "command",
    "dialog",
    "dropdown-menu",
    "empty",
    "field",
    "input",
    "input-group",
    "label",
    "marker",
    "message",
    "message-scroller",
    "popover",
    "select",
    "separator",
    "sheet",
    "sidebar",
    "skeleton",
    "sonner",
    "spinner",
    "switch",
    "table",
    "tabs",
    "textarea",
    "tooltip"
  ],
  "starterCapabilities": {
    "tanstackStartApp": {
      "primitives": "all",
      "layoutsAndBlocks": ["AppShell", "SidebarNav", "PageHeader", "MetricCard", "EmptyState", "StarterDashboard"]
    }
  },
  "blocks": {
    "marketing": [
      "Hero",
      "HeroSplit",
      "Features",
      "Bento",
      "Pricing",
      "Stats",
      "Testimonials",
      "LogoCloud",
      "Team",
      "Gallery",
      "CTA",
      "Footer",
      "FAQ",
      "Newsletter"
    ],
    "app": [
      "AppShell",
      "SidebarNav",
      "PageHeader",
      "MetricCard",
      "ChartCard",
      "DataTable",
      "FilterBar",
      "EmptyState",
      "SettingsForm"
    ],
    "chat": ["ChatShell", "MessageList", "PromptComposer", "AttachmentRow", "StatusMarker"],
    "nav": ["SiteNav"],
    "motion": ["Reveal"]
  },
  "verification": {
    "commands": [
      "pnpm check:design-system",
      "pnpm check:react-blocks",
      "pnpm check:visual-drift",
      "pnpm -r check",
      "pnpm --filter @continual/tanstack-start-app-template build",
      "pnpm verify:templates",
      "pnpm verify:offline-cache:warm"
    ]
  }
}
