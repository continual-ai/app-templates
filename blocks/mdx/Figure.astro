---
/**
 * Figure — image with an optional caption, for MDX/article bodies. Static.
 * Tier: mdx component.
 * Props:
 *   src (required, string)
 *   alt (required, string)
 *   caption? (string)
 * Prerequisites: none. For local imported images prefer astro:assets <Image>;
 *   this takes a plain string src for flexibility in MDX.
 * Usage (in MDX):
 *   import Figure from "@/components/mdx/Figure.astro";
 *   <Figure src="/diagram.png" alt="System diagram" caption="How requests flow." />
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-6 flex flex-col gap-2">
  <img src={src} alt={alt} loading="lazy" class="bg-muted w-full rounded-xl border" />
  {caption && <figcaption class="text-muted-foreground text-center text-sm text-pretty">{caption}</figcaption>}
</figure>
