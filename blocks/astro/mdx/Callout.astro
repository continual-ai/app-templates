---
/**
 * Callout — highlighted aside for MDX/article bodies, with info / warn / success
 * variants. Static. Tier: mdx component.
 * Props:
 *   variant? ("info" | "warn" | "success", default "info")
 *   title? (string)
 * Slot: the callout body (default slot).
 * Prerequisites: none beyond template defaults.
 * Note: the base token palette has no dedicated success/warning hues, so variants
 *   map to existing tokens — info → muted/foreground, success → primary,
 *   warn → destructive. A themed App can add semantic tokens if it needs them.
 * Usage (in MDX):
 *   import Callout from "@/components/mdx/Callout.astro";
 *   <Callout variant="warn" title="Heads up">Back up first.</Callout>
 */
interface Props {
  variant?: "info" | "warn" | "success";
  title?: string;
}

const { variant = "info", title } = Astro.props;

const styles: Record<NonNullable<Props["variant"]>, { box: string; accent: string }> = {
  info: { box: "bg-muted border-border", accent: "text-foreground" },
  success: { box: "bg-primary/10 border-primary/30", accent: "text-primary" },
  warn: { box: "bg-destructive/10 border-destructive/30", accent: "text-destructive" },
};

const icons: Record<NonNullable<Props["variant"]>, string> = {
  info: "M12 8h.01M11 12h1v4h1",
  success: "M20 6 9 17l-5-5",
  warn: "M12 9v4m0 4h.01",
};

const { box, accent } = styles[variant];
---

<aside class={`my-6 flex gap-3 rounded-xl border p-4 ${box}`}>
  <svg
    class={`mt-0.5 size-5 shrink-0 ${accent}`}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {variant !== "warn" && <circle cx="12" cy="12" r="9"></circle>}
    {variant === "warn" && <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>}
    <path d={icons[variant]}></path>
  </svg>
  <div class="flex min-w-0 flex-col gap-1 text-sm">
    {title && <p class={`font-medium ${accent}`}>{title}</p>}
    <div class="text-muted-foreground text-pretty [&>:first-child]:mt-0 [&>:last-child]:mb-0">
      <slot />
    </div>
  </div>
</aside>
