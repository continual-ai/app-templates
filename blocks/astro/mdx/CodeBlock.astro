---
/**
 * CodeBlock — a <pre> wrapper with a copy-to-clipboard button. Designed to
 * REPLACE the default `pre` element in MDX so every fenced code block gets a
 * copy button (wire it via the MDX components map — see AGENTS.md "Blog /
 * content"). The copy handler is a single deduped, delegated script (not one
 * per instance). Static markup + a tiny vanilla listener (no React).
 * Tier: mdx component.
 * Props: none (receives the rendered <code> as its default slot).
 * Prerequisites: none beyond template defaults.
 * Usage (in a layout rendering MDX):
 *   import CodeBlock from "@/components/mdx/CodeBlock.astro";
 *   <Content components={{ pre: CodeBlock }} />
 */
---

<figure class="group relative my-6" data-code-block>
  <button
    type="button"
    data-copy-button
    aria-label="Copy code"
    class="bg-background/80 text-muted-foreground hover:text-foreground absolute top-2 right-2 rounded-md border px-2 py-1 text-xs opacity-0 backdrop-blur transition focus-visible:opacity-100 group-hover:opacity-100"
  >
    Copy
  </button>
  <pre class="bg-muted overflow-x-auto rounded-xl border p-4 text-sm"><slot /></pre>
</figure>

<script>
  // Deduped across the page (Astro bundles component scripts once). Delegated so
  // it covers every CodeBlock instance.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>("[data-copy-button]");
    if (!button) return;
    const pre = button.closest("[data-code-block]")?.querySelector("pre");
    if (!pre) return;
    navigator.clipboard.writeText(pre.innerText).then(() => {
      const original = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = original;
      }, 1500);
    });
  });
</script>
