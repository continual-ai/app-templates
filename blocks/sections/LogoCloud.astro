---
/**
 * LogoCloud — "trusted by" logo wall with optional small muted label, then a
 * centered responsive grid of logos (image or text fallback). Static (renders
 * to HTML, ships no JS).
 * Tier: block / section.
 * Props:
 *   logos (required, { name: string; src?: string }[])
 *   heading? (string)
 * Prerequisites: none beyond template defaults.
 * Usage:
 *   import LogoCloud from "@/components/sections/LogoCloud.astro";
 *   <LogoCloud
 *     heading="Trusted by teams at"
 *     logos={[
 *       { name: "Acme", src: "/logos/acme.svg" },
 *       { name: "Globex" },
 *     ]}
 *   />
 */
interface Logo {
  name: string;
  src?: string;
}

interface Props {
  logos: Logo[];
  heading?: string;
}

const { logos, heading } = Astro.props;
---

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    {
      heading && (
        <p class="text-muted-foreground mb-10 text-center text-sm font-medium tracking-wide uppercase">
          {heading}
        </p>
      )
    }
    <div class="grid grid-cols-2 place-items-center gap-x-12 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
      {
        logos.map((logo) =>
          logo.src ? (
            <img
              src={logo.src}
              alt={logo.name}
              class="h-8 w-auto opacity-70 grayscale transition hover:opacity-100"
              loading="lazy"
            />
          ) : (
            <span class="text-muted-foreground text-lg font-medium">{logo.name}</span>
          )
        )
      }
    </div>
  </div>
</section>
