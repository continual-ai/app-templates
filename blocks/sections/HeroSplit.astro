---
/**
 * HeroSplit — two-column hero: copy + CTAs on the left, a visual on the right
 * (drop an <Image/>, illustration, or screenshot into slot="visual"). Stacks to
 * a single column on mobile. Static (renders to HTML, ships no JS).
 * Tier: block / section.
 * Props:
 *   title (required, string)
 *   subtitle? (string)
 *   eyebrow? (string)
 *   primaryCta? ({ label, href })
 *   secondaryCta? ({ label, href })
 * Slots: "visual" (right-hand media; falls back to a muted placeholder panel).
 * Prerequisites: @/components/ui/button.
 * Usage:
 *   import HeroSplit from "@/components/sections/HeroSplit.astro";
 *   import { Image } from "astro:assets";
 *   import shot from "@/assets/app.png";
 *   <HeroSplit title="…" subtitle="…" primaryCta={{ label: "Start", href: "/signup" }}>
 *     <Image slot="visual" src={shot} alt="App screenshot" />
 *   </HeroSplit>
 */
import { Button } from "@/components/ui/button";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
}

const { title, subtitle, eyebrow, primaryCta, secondaryCta } = Astro.props;
const hasVisual = Astro.slots.has("visual");
---

<section class="px-6 py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
    <div class="flex flex-col items-start gap-6">
      {
        eyebrow && (
          <span class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
            {eyebrow}
          </span>
        )
      }
      <h1
        class="text-foreground font-heading text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
      >
        {title}
      </h1>
      {subtitle && <p class="text-muted-foreground text-lg text-pretty">{subtitle}</p>}
      {
        (primaryCta || secondaryCta) && (
          <div class="flex flex-wrap items-center gap-3">
            {primaryCta && (
              <Button asChild size="lg">
                <a href={primaryCta.href}>{primaryCta.label}</a>
              </Button>
            )}
            {secondaryCta && (
              <Button asChild size="lg" variant="outline">
                <a href={secondaryCta.href}>{secondaryCta.label}</a>
              </Button>
            )}
          </div>
        )
      }
    </div>
    <div class="bg-muted aspect-video w-full overflow-hidden rounded-xl border">
      {hasVisual && <slot name="visual" />}
    </div>
  </div>
</section>
