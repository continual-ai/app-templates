---
/**
 * Stats — metrics band: optional centered heading/subhead above a responsive
 * grid of value/label pairs, wrapped in a subtle muted panel. Static (renders
 * to HTML, ships no JS).
 * Tier: block / section.
 * Props:
 *   items (required, { value: string; label: string }[])
 *   heading? (string)
 *   subheading? (string)
 * Prerequisites: none beyond template defaults.
 * Usage:
 *   import Stats from "@/components/sections/Stats.astro";
 *   <Stats
 *     heading="Trusted at scale"
 *     items={[
 *       { value: "99.9%", label: "Uptime" },
 *       { value: "2M+", label: "Requests / day" },
 *     ]}
 *   />
 */
interface Stat {
  value: string;
  label: string;
}

interface Props {
  items: Stat[];
  heading?: string;
  subheading?: string;
}

const { items, heading, subheading } = Astro.props;

const columns =
  items.length <= 2 ? "sm:grid-cols-2" : items.length === 3 ? "sm:grid-cols-3" : "md:grid-cols-4";
---

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    {
      (heading || subheading) && (
        <div class="mx-auto mb-12 max-w-2xl text-center">
          {heading && (
            <h2 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance">
              {heading}
            </h2>
          )}
          {subheading && <p class="text-muted-foreground mt-3 text-pretty">{subheading}</p>}
        </div>
      )
    }
    <dl class={`bg-muted grid grid-cols-2 gap-8 rounded-xl border p-8 sm:p-12 ${columns}`}>
      {
        items.map((item) => (
          <div class="flex flex-col items-center gap-2 text-center">
            <dt class="sr-only">{item.label}</dt>
            <dd class="text-foreground font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
              {item.value}
            </dd>
            <p class="text-muted-foreground text-sm text-pretty">{item.label}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>
