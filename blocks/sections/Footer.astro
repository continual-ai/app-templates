---
/**
 * Footer — multi-column site footer (brand + link columns + copyright row).
 * Static (renders to HTML, ships no JS). Tier: block / section.
 * Props:
 *   brand? (string)
 *   tagline? (string)
 *   columns? ({ title: string; links: { label: string; href: string }[] }[])
 *   note? (string — defaults to "© <brand>")
 * Prerequisites: none beyond template defaults.
 * Usage:
 *   import Footer from "@/components/sections/Footer.astro";
 *   <Footer
 *     brand="Acme"
 *     tagline="Ship faster."
 *     columns={[{ title: "Product", links: [{ label: "Pricing", href: "/pricing" }] }]}
 *   />
 */
interface Link {
  label: string;
  href: string;
}

interface Column {
  title: string;
  links: Link[];
}

interface Props {
  brand?: string;
  tagline?: string;
  columns?: Column[];
  note?: string;
}

const { brand, tagline, columns = [], note } = Astro.props;
const copyright = note ?? (brand ? `© ${brand}` : undefined);
---

<div class="mx-auto w-full max-w-6xl px-6 py-12">
  <div class="flex flex-col justify-between gap-10 sm:flex-row">
    {
      (brand || tagline) && (
        <div class="flex max-w-xs flex-col gap-2">
          {brand && <span class="text-foreground font-semibold tracking-tight">{brand}</span>}
          {tagline && <p class="text-muted-foreground text-sm text-pretty">{tagline}</p>}
        </div>
      )
    }
    {
      columns.length > 0 && (
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
          {columns.map((col) => (
            <div class="flex flex-col gap-3">
              <span class="text-foreground text-sm font-medium">{col.title}</span>
              <ul class="flex flex-col gap-2">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-muted-foreground hover:text-foreground text-sm"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </div>
  {
    copyright && (
      <p class="text-muted-foreground mt-10 border-t pt-6 text-xs">
        {copyright}
      </p>
    )
  }
</div>
