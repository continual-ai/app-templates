---
/**
 * Hero (centered) — eyebrow + headline + subhead + up to two CTAs, centered.
 * Tier: block / section. Static (renders to HTML, ships no JS).
 * Props:
 *   title (required, string)
 *   subtitle? (string)
 *   eyebrow? (string)
 *   primaryCta? ({ label, href })
 *   secondaryCta? ({ label, href })
 * Prerequisites: @/components/ui/button (ships with the template).
 * Usage:
 *   import Hero from "@/components/sections/Hero.astro";
 *   <Hero title="Ship faster" subtitle="…" primaryCta={{ label: "Start", href: "/signup" }} />
 */
import { Button } from "@/components/ui/button";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
}

const { title, subtitle, eyebrow, primaryCta, secondaryCta } = Astro.props;
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
    {
      eyebrow && (
        <span class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
          {eyebrow}
        </span>
      )
    }
    <h1
      class="text-foreground font-heading text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
    >
      {title}
    </h1>
    {subtitle && <p class="text-muted-foreground max-w-xl text-lg text-pretty">{subtitle}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="flex flex-wrap items-center justify-center gap-3">
          {primaryCta && (
            <Button asChild size="lg">
              <a href={primaryCta.href}>{primaryCta.label}</a>
            </Button>
          )}
          {secondaryCta && (
            <Button asChild size="lg" variant="outline">
              <a href={secondaryCta.href}>{secondaryCta.label}</a>
            </Button>
          )}
        </div>
      )
    }
  </div>
</section>
