---
/**
 * CTA — centered call-to-action band (heading + optional subtext + button) on a
 * muted panel. Static (renders to HTML, ships no JS).
 * Tier: block / section.
 * Props:
 *   title (required, string)
 *   subtitle? (string)
 *   cta? ({ label, href })
 * Prerequisites: @/components/ui/button.
 * Usage:
 *   import CTA from "@/components/sections/CTA.astro";
 *   <CTA title="Ready to start?" subtitle="Free for 14 days." cta={{ label: "Get started", href: "/signup" }} />
 */
import { Button } from "@/components/ui/button";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  cta?: Cta;
}

const { title, subtitle, cta } = Astro.props;
---

<section class="px-6 py-20">
  <div class="bg-muted mx-auto flex max-w-5xl flex-col items-center gap-5 rounded-2xl border px-6 py-14 text-center shadow-sm">
    <h2 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance">
      {title}
    </h2>
    {subtitle && <p class="text-muted-foreground max-w-xl text-pretty">{subtitle}</p>}
    {
      cta && (
        <Button asChild size="lg">
          <a href={cta.href}>{cta.label}</a>
        </Button>
      )
    }
  </div>
</section>
