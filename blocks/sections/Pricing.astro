---
/**
 * Pricing — responsive grid of tiered pricing cards with a highlighted
 * "popular" tier (optional eyebrow/heading above the grid). Static (renders to
 * HTML, ships no JS).
 * Tier: block / section.
 * Props:
 *   tiers (required, { name: string; price: string; period?: string; description?: string; features: string[]; cta: { label: string; href: string }; popular?: boolean }[])
 *   heading? (string)
 *   subheading? (string)
 * Prerequisites: @/components/ui/button (ships with the template).
 * Usage:
 *   import Pricing from "@/components/sections/Pricing.astro";
 *   <Pricing
 *     heading="Simple, transparent pricing"
 *     tiers={[
 *       { name: "Starter", price: "$0", period: "/mo", features: ["1 project", "Community support"], cta: { label: "Get started", href: "/signup" } },
 *       { name: "Pro", price: "$19", period: "/mo", features: ["Unlimited projects", "Priority support"], cta: { label: "Start free trial", href: "/signup" }, popular: true },
 *     ]}
 *   />
 */
import { Button } from "@/components/ui/button";

interface Cta {
  label: string;
  href: string;
}

interface Tier {
  name: string;
  price: string;
  period?: string;
  description?: string;
  features: string[];
  cta: Cta;
  popular?: boolean;
}

interface Props {
  tiers: Tier[];
  heading?: string;
  subheading?: string;
}

const { tiers, heading, subheading } = Astro.props;
---

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    {
      (heading || subheading) && (
        <div class="mx-auto mb-12 max-w-2xl text-center">
          {heading && (
            <h2 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance">
              {heading}
            </h2>
          )}
          {subheading && <p class="text-muted-foreground mt-3 text-pretty">{subheading}</p>}
        </div>
      )
    }
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <div
            class:list={[
              "bg-card text-card-foreground flex flex-col gap-6 rounded-xl border p-6 shadow-sm",
              tier.popular && "border-primary ring-primary ring-1",
            ]}
          >
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-foreground font-medium">{tier.name}</h3>
                {tier.popular && (
                  <span class="bg-primary text-primary-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">
                    Popular
                  </span>
                )}
              </div>
              <p class="flex items-baseline gap-1">
                <span class="text-foreground font-heading text-4xl font-semibold tracking-tight">
                  {tier.price}
                </span>
                {tier.period && <span class="text-muted-foreground text-sm">{tier.period}</span>}
              </p>
              {tier.description && (
                <p class="text-muted-foreground text-sm text-pretty">{tier.description}</p>
              )}
            </div>
            <ul class="flex flex-col gap-3 text-sm">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <svg
                    class="text-primary mt-0.5 size-4 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span class="text-muted-foreground text-pretty">{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-2">
              <Button asChild className="w-full" variant={tier.popular ? "default" : "outline"}>
                <a href={tier.cta.href}>{tier.cta.label}</a>
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
