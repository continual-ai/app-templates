---
/**
 * Team — responsive grid of people cards (avatar + name + role, optional
 * bio/links, optional eyebrow/heading above the grid). Static (renders to
 * HTML, ships no JS). Tier: block / section.
 * Props:
 *   members (required, { name: string; role: string; bio?: string; image?: string; links?: { label: string; href: string }[] }[])
 *   heading? (string)
 *   subheading? (string)
 * Prerequisites: none beyond template defaults.
 * Usage:
 *   import Team from "@/components/sections/Team.astro";
 *   <Team
 *     heading="Meet the team"
 *     members={[
 *       { name: "Ada Lovelace", role: "Founder", bio: "Builds the future." },
 *       { name: "Alan Turing", role: "Engineer", image: "/team/alan.jpg" },
 *     ]}
 *   />
 */
interface Link {
  label: string;
  href: string;
}

interface Member {
  name: string;
  role: string;
  bio?: string;
  image?: string;
  links?: Link[];
}

interface Props {
  members: Member[];
  heading?: string;
  subheading?: string;
}

const { members, heading, subheading } = Astro.props;
---

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    {
      (heading || subheading) && (
        <div class="mx-auto mb-12 max-w-2xl text-center">
          {heading && (
            <h2 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance">
              {heading}
            </h2>
          )}
          {subheading && <p class="text-muted-foreground mt-3 text-pretty">{subheading}</p>}
        </div>
      )
    }
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        members.map((member) => (
          <div class="bg-card flex flex-col items-center gap-3 rounded-xl border p-6 text-center shadow-sm transition-shadow hover:shadow-md">
            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="bg-muted size-20 rounded-full object-cover"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="bg-muted size-20 rounded-full" aria-hidden="true" />
            )}
            <div class="flex flex-col gap-1">
              <h3 class="text-foreground font-medium">{member.name}</h3>
              <p class="text-muted-foreground text-sm">{member.role}</p>
            </div>
            {member.bio && (
              <p class="text-muted-foreground text-sm text-pretty">{member.bio}</p>
            )}
            {member.links && member.links.length > 0 && (
              <ul class="flex flex-wrap items-center justify-center gap-3">
                {member.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-primary text-sm hover:underline">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
