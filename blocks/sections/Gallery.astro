---
/**
 * Gallery — responsive image grid (2/3/4 columns) with optional captions and
 * an optional centered heading/subheading above the grid. Static (renders to
 * HTML, ships no JS; no lightbox).
 * Tier: block / section.
 * Props:
 *   images (required, { src: string; alt: string; caption?: string }[])
 *   columns? (2 | 3 | 4, default 3)
 *   heading? (string)
 *   subheading? (string)
 * For local imported images prefer astro:assets <Image>; this block takes plain
 * string srcs for flexibility.
 * Prerequisites: none beyond template defaults.
 * Usage:
 *   import Gallery from "@/components/sections/Gallery.astro";
 *   <Gallery
 *     heading="Our work"
 *     columns={3}
 *     images={[
 *       { src: "/photos/one.jpg", alt: "Team at the launch event", caption: "Launch day" },
 *       { src: "/photos/two.jpg", alt: "Office workspace with plants" },
 *     ]}
 *   />
 */
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  columns?: 2 | 3 | 4;
  heading?: string;
  subheading?: string;
}

const { images, columns = 3, heading, subheading } = Astro.props;

const columnClasses = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};
---

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    {
      (heading || subheading) && (
        <div class="mx-auto mb-12 max-w-2xl text-center">
          {heading && (
            <h2 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance">
              {heading}
            </h2>
          )}
          {subheading && <p class="text-muted-foreground mt-3 text-pretty">{subheading}</p>}
        </div>
      )
    }
    <div class={`grid gap-6 ${columnClasses[columns]}`}>
      {
        images.map((image) => (
          <figure class="bg-muted overflow-hidden rounded-xl border">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="aspect-[4/3] h-auto w-full object-cover"
            />
            {image.caption && (
              <figcaption class="text-muted-foreground p-4 text-sm text-pretty">
                {image.caption}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>
