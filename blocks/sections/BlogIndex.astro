---
/**
 * BlogIndex — a list of blog posts as cards. Decoupled from the content
 * collection: the caller maps getCollection("blog") into the `posts` prop, so
 * this block stays a pure presentational section. Static.
 * Tier: block / section.
 * Props:
 *   posts: Array<{ title; href; date (Date); description?; author?; image? (string) }>
 *   heading?, subheading?
 * Prerequisites: none beyond template defaults.
 * Usage (in src/pages/blog/index.astro):
 *   const entries = (await getCollection("blog")).filter(p => !p.data.draft);
 *   const posts = entries.map(e => ({ ...e.data, href: `/blog/${e.id}` }));
 *   <BlogIndex heading="Blog" posts={posts} />
 */
interface Post {
  title: string;
  href: string;
  date: Date;
  description?: string;
  author?: string;
  image?: string;
}

interface Props {
  posts: Post[];
  heading?: string;
  subheading?: string;
}

const { posts, heading, subheading } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<section class="px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-5xl">
    {
      (heading || subheading) && (
        <div class="mb-10 max-w-2xl">
          {heading && (
            <h2 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance">
              {heading}
            </h2>
          )}
          {subheading && <p class="text-muted-foreground mt-3 text-pretty">{subheading}</p>}
        </div>
      )
    }
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <li class="bg-card relative flex flex-col overflow-hidden rounded-xl border shadow-sm transition-shadow hover:shadow-md">
            {post.image && (
              <img src={post.image} alt="" loading="lazy" class="bg-muted aspect-[16/9] w-full object-cover" />
            )}
            <div class="flex flex-1 flex-col gap-2 p-5">
              <p class="text-muted-foreground text-xs">
                <time datetime={post.date.toISOString()}>{fmt(post.date)}</time>
                {post.author && <span> · {post.author}</span>}
              </p>
              <h3 class="text-foreground font-medium text-pretty">
                <a href={post.href} class="after:absolute after:inset-0">
                  {post.title}
                </a>
              </h3>
              {post.description && (
                <p class="text-muted-foreground line-clamp-3 text-sm text-pretty">{post.description}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
