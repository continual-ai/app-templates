{
  "name": "@continual/nextjs-app-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "check": "next typegen && tsc --noEmit",
    "clean:continual": "node -e \"require('node:fs').rmSync('.continual/wrangler',{recursive:true,force:true})\"",
    "bundle:continual": "opennextjs-cloudflare build && pnpm clean:continual && pnpm exec wrangler deploy --dry-run --outdir .continual/wrangler",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@continual/sdk": "0.1.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.68.0"
  }
}
