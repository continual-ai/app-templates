{
  "name": "@continual/react-app-template",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "clean:continual": "node -e \"require('node:fs').rmSync('.continual/wrangler',{recursive:true,force:true})\"",
    "bundle:continual": "pnpm build && pnpm clean:continual && pnpm exec wrangler deploy --dry-run --outdir .continual/wrangler",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@continual/sdk": "0.1.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@shadcn/react": "^0.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.11.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.11.0",
    "recharts": "^3.9.2",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.24.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.68.0"
  }
}
