---
// This page is a placeholder. The agent overwrites it on every App's first
// turn so a user who asked for "a blog about cats" doesn't see a generic
// landing card. Don't put real content here — keep it honest about the
// in-progress state.
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Setting up your App">
  <main class="grid min-h-screen place-items-center px-6">
    <div class="flex flex-col items-center gap-4 text-center">
      <span class="text-muted-foreground inline-flex items-center gap-2 text-sm font-medium tracking-wide uppercase">
        <span class="bg-muted-foreground/60 size-1.5 animate-pulse rounded-full"></span>
        Continual
      </span>
      <h1 class="text-foreground text-2xl font-medium tracking-tight">
        Setting up your App…
      </h1>
    </div>
  </main>
</Layout>
