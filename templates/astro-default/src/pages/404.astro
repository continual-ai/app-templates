---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found" description="The page you're looking for doesn't exist.">
  <main class="grid min-h-screen place-items-center px-6">
    <div class="flex flex-col items-center gap-4 text-center">
      <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">404</p>
      <h1 class="text-foreground text-2xl font-medium tracking-tight">This page doesn't exist</h1>
      <a href="/" class="text-primary text-sm underline-offset-4 hover:underline">Go back home</a>
    </div>
  </main>
</Layout>
