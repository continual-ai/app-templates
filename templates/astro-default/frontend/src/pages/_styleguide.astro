---
/**
 * _styleguide — design-system reference: the full token palette (light + dark),
 * the type scale, and a catalog of every block + layout in the library. For the
 * agent and the design-mode overlay to see the whole system at a glance.
 *
 * This is a DESIGN-SYSTEM reference. It's `_`-prefixed, so Astro never builds it
 * into a page or the sitemap — it won't ship from a scaffold (safe to delete).
 * To VIEW it live, temporarily rename it to `styleguide.astro` and run the dev
 * server.
 *
 * It renders the GLOBAL system (tokens + type — these are always present) and
 * CATALOGS the blocks rather than importing them: blocks are copy-on-demand and
 * only resolve their deps once copied into `src/components/…`, so a reference
 * page can't import them from the repo library directly. Copy a block in to see
 * it rendered; the catalog below is the index of what's available.
 */
import Layout from "@/layouts/Layout.astro";
import StyleguidePreview from "@/components/StyleguidePreview";

const tokenPairs: Array<[string, string, string]> = [
  ["bg-background", "text-foreground", "background / foreground"],
  ["bg-card", "text-card-foreground", "card / card-foreground"],
  ["bg-popover", "text-popover-foreground", "popover / popover-foreground"],
  ["bg-primary", "text-primary-foreground", "primary / primary-foreground"],
  ["bg-secondary", "text-secondary-foreground", "secondary / secondary-foreground"],
  ["bg-muted", "text-muted-foreground", "muted / muted-foreground"],
  ["bg-accent", "text-accent-foreground", "accent / accent-foreground"],
  ["bg-destructive", "text-background", "destructive"],
];

const catalog: Array<{ group: string; items: Array<[string, string]> }> = [
  {
    group: "Layouts — /opt/site-templates/layouts/",
    items: [
      ["MarketingLayout", "Contained single-column page (about, pricing, contact)."],
      ["SectionedLayout", "Full-bleed landing: stacked sections."],
      ["SidebarLayout", "App/dashboard: sticky header + responsive sidebar drawer."],
      ["DocsLayout", "Docs: sidebar nav + content + on-page TOC rail."],
      ["BlogPostLayout", "Single post: header + cover + token-aware prose."],
    ],
  },
  {
    group: "React marketing blocks — /opt/site-templates/blocks/react/marketing/",
    items: [
      ["Hero", "Centered hero: eyebrow + headline + subhead + CTAs."],
      ["HeroSplit", "Two-column hero: copy left, visual right."],
      ["Features", "Responsive grid of feature cards."],
      ["Bento", "Asymmetric feature grid with spans."],
      ["Pricing", "Tiered pricing with a popular highlight."],
      ["Stats", "Metrics band."],
      ["Testimonials", "Quote cards grid."],
      ["LogoCloud", "Trusted-by logo wall."],
      ["Team", "People cards with roles + links."],
      ["Gallery", "Responsive image grid with captions."],
      ["CTA", "Centered call-to-action band."],
      ["Footer", "Multi-column footer."],
      ["FAQ (island)", "Accordion of Q&A — client:visible."],
      ["Newsletter (island)", "Email capture — client:visible."],
    ],
  },
  {
    group: "React app/chat blocks",
    items: [
      ["app/AppShell", "Dashboard shell with sidebar + top bar."],
      ["app/PageHeader", "Route title, description, and action row."],
      ["app/MetricCard", "KPI card with trend indicator."],
      ["app/ChartCard", "Recharts-backed chart card using shared chart tokens."],
      ["app/DataTable", "Searchable, sortable, selectable, paginated table pattern."],
      ["app/FilterBar", "Search/filter/action toolbar."],
      ["app/EmptyState", "Empty-state composition using shadcn Empty."],
      ["chat/ChatShell", "Transport-agnostic chat frame."],
      ["chat/MessageList", "Message scroller + message rows."],
      ["chat/PromptComposer", "Textarea prompt composer."],
      ["chat/AttachmentRow", "Attachment strip."],
      ["chat/StatusMarker", "Streaming/status marker."],
    ],
  },
  {
    group: "Nav / motion / Astro-only content",
    items: [
      ["react/nav/SiteNav (island)", "Header nav with mobile menu — client:load."],
      ["react/motion/Reveal (island)", "Scroll fade/slide-up with stagger — client:visible."],
      ["astro/sections/BlogIndex", "Post cards (maps a content collection)."],
      ["astro/mdx/Callout", "Info / warn / success aside."],
      ["astro/mdx/Figure", "Image + caption."],
      ["astro/mdx/CodeBlock", "Code with a copy button (MDX `pre` override)."],
    ],
  },
];
---

<Layout title="Styleguide">
  <main class="mx-auto flex max-w-6xl flex-col gap-16 px-6 py-12">
    <header class="flex flex-col gap-2">
      <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">Design system</p>
      <h1 class="text-foreground font-heading text-3xl font-semibold tracking-tight">Styleguide</h1>
      <p class="text-muted-foreground text-pretty">
        Token palette, type scale, and the full block + layout catalog.
      </p>
    </header>

    <section class="flex flex-col gap-4">
      <h2 class="text-foreground font-heading text-xl font-semibold">Tokens</h2>
      <div class="grid gap-6 lg:grid-cols-2">
        {
          [false, true].map((dark) => (
            <div class={dark ? "dark" : ""}>
              <div class="bg-background flex flex-col gap-2 rounded-xl border p-5">
                <p class="text-muted-foreground mb-1 text-xs font-medium tracking-wide uppercase">
                  {dark ? "Dark" : "Light"}
                </p>
                {tokenPairs.map(([bg, fg, label]) => (
                  <div class={`${bg} ${fg} flex items-center justify-between rounded-md border px-3 py-2 text-sm`}>
                    <span>{label}</span>
                    <span class="opacity-70">Aa</span>
                  </div>
                ))}
                <div class="mt-2 flex gap-3">
                  <div class="flex flex-col items-center gap-1">
                    <div class="border-border bg-background size-8 rounded-md border-2" />
                    <span class="text-muted-foreground text-xs">border</span>
                  </div>
                  <div class="flex flex-col items-center gap-1">
                    <div class="border-input bg-background size-8 rounded-md border-2" />
                    <span class="text-muted-foreground text-xs">input</span>
                  </div>
                  <div class="flex flex-col items-center gap-1">
                    <div class="border-ring bg-background size-8 rounded-md border-2" />
                    <span class="text-muted-foreground text-xs">ring</span>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-foreground font-heading text-xl font-semibold">Typography</h2>
      <div class="flex flex-col gap-2 rounded-xl border p-5">
        <p class="text-foreground font-heading text-5xl font-semibold tracking-tight">Heading 5xl</p>
        <p class="text-foreground font-heading text-3xl font-semibold tracking-tight">Heading 3xl</p>
        <p class="text-foreground font-heading text-xl font-medium">Heading xl</p>
        <p class="text-foreground text-base">Body — the quick brown fox jumps over the lazy dog.</p>
        <p class="text-muted-foreground text-sm">Muted small — supporting copy and captions.</p>
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-foreground font-heading text-xl font-semibold">Primitive & chat preview</h2>
      <StyleguidePreview client:load />
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-foreground font-heading text-xl font-semibold">Block & layout catalog</h2>
      {
        catalog.map((section) => (
          <div class="flex flex-col gap-2">
            <h3 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
              {section.group}
            </h3>
            <ul class="divide-border divide-y rounded-xl border">
              {section.items.map(([name, desc]) => (
                <li class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:gap-4">
                  <span class="text-foreground w-48 shrink-0 font-medium">{name}</span>
                  <span class="text-muted-foreground text-sm text-pretty">{desc}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </main>
</Layout>
