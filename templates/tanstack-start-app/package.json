{
  "name": "@continual/tanstack-start-app-template",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "check": "vite build && tsc --noEmit",
    "clean:continual": "node -e \"require('node:fs').rmSync('.continual/wrangler',{recursive:true,force:true})\"",
    "bundle:continual": "pnpm build && pnpm clean:continual && pnpm exec wrangler deploy --dry-run --config dist/server/wrangler.json --outdir .continual/wrangler",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@continual/sdk": "0.1.4",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@shadcn/react": "0.2.0",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-start": "1.168.38",
    "@tailwindcss/vite": "4.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.16.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.9.2",
    "shadcn": "4.7.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "vite": "7.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "wrangler": "4.119.0"
  }
}
