# ─── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build output (any template) ───────────────────────────────────────────
**/dist/
**/.astro/
**/.next/
**/.output/
**/.svelte-kit/

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local-server-manager artifacts (only appears in scaffolded sites, but
# safest to ignore at the workspace root too)
.server-*.pid
.server-*.log

# ─── Environment ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─── Editor / OS ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ─── TypeScript ────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Playwright / browser tooling ──────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/

# ─── Misc ──────────────────────────────────────────────────────────────────
.cache/
coverage/
