---
/**
 * DocsLayout — documentation shell: sticky header, a left nav sidebar (sticky on
 * desktop, pure-CSS slide-in drawer on mobile), a readable content column, and an
 * optional right-hand "on this page" TOC rail shown on xl screens. Self-contained
 * (no JavaScript; static-safe).
 *
 * Tier: layout (page shell; wraps the base src/layouts/Layout.astro).
 * Props: title (required), description?, image?, canonical?, type?.
 * Slots: "header", "sidebar" (section nav), default (the article body), "toc" (optional right rail).
 * Prerequisites: base src/layouts/Layout.astro. No `prose` styles ship by default —
 *   add @tailwindcss/typography (and a `prose` class) if you want automatic article
 *   typography, or style headings/paragraphs directly.
 * Usage:
 *   import DocsLayout from "@/layouts/DocsLayout.astro";
 *   <DocsLayout title="Getting started — Docs">
 *     <span slot="header" class="font-semibold">Acme Docs</span>
 *     <nav slot="sidebar" class="flex flex-col gap-1 text-sm">…</nav>
 *     <article class="flex flex-col gap-4">…</article>
 *     <nav slot="toc" class="flex flex-col gap-2 text-sm">…</nav>
 *   </DocsLayout>
 */
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
}

const { title, description, image, canonical, type } = Astro.props;
const hasToc = Astro.slots.has("toc");
---

<Layout title={title} description={description} image={image} canonical={canonical} type={type}>
  <div class="flex min-h-screen flex-col">
    <header
      class="bg-background/80 sticky top-0 z-40 flex h-14 items-center gap-3 border-b px-4 backdrop-blur"
    >
      <label
        for="ds-docs-nav"
        class="hover:bg-muted inline-flex size-8 cursor-pointer items-center justify-center rounded-md lg:hidden"
        aria-label="Toggle navigation"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </label>
      <slot name="header" />
    </header>

    <div class="mx-auto flex w-full max-w-7xl flex-1">
      <input id="ds-docs-nav" type="checkbox" class="peer hidden" />
      <label
        for="ds-docs-nav"
        class="bg-foreground/20 fixed inset-0 z-30 hidden peer-checked:block lg:hidden"
        aria-hidden="true"></label>
      <aside
        class="bg-background fixed inset-y-0 left-0 z-40 w-64 -translate-x-full overflow-y-auto border-r px-4 py-6 transition-transform peer-checked:translate-x-0 lg:sticky lg:top-14 lg:z-0 lg:h-[calc(100vh-3.5rem)] lg:translate-x-0"
      >
        <slot name="sidebar" />
      </aside>

      <main class="min-w-0 flex-1 px-6 py-10">
        <div class="mx-auto w-full max-w-3xl">
          <slot />
        </div>
      </main>

      {
        hasToc && (
          <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-56 shrink-0 overflow-y-auto py-10 pr-6 xl:block">
            <p class="text-muted-foreground mb-3 text-xs font-medium tracking-wide uppercase">
              On this page
            </p>
            <slot name="toc" />
          </aside>
        )
      }
    </div>
  </div>
</Layout>
