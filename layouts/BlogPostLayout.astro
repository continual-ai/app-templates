---
/**
 * BlogPostLayout — article shell for a single blog post: wraps the base Layout,
 * renders a title / date / author header and an optional cover image, and a
 * token-aware `prose` body (the default slot is the rendered post content).
 *
 * Tier: layout (page shell; wraps the base src/layouts/Layout.astro).
 * OPT-IN: the `prose` styles need @tailwindcss/typography — see AGENTS.md
 * "Blog / content" for the one-time setup. Without the plugin the body renders
 * unstyled (no error).
 * Props:
 *   title (required), description?, date (Date), author?, image? (ImageMetadata | string)
 * Slot: default = the rendered post body (MDX/Markdown <Content />).
 * Prerequisites: base src/layouts/Layout.astro; @tailwindcss/typography (opt-in).
 * Usage (in src/pages/blog/[slug].astro):
 *   const { Content } = await render(entry);
 *   <BlogPostLayout {...entry.data}><Content components={{ pre: CodeBlock }} /></BlogPostLayout>
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  description?: string;
  date: Date;
  author?: string;
  image?: ImageMetadata | string;
}

const { title, description, date, author, image } = Astro.props;
const dateLabel = date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={title} description={description} type="article">
  <article class="mx-auto w-full max-w-2xl px-6 py-16">
    <header class="mb-8 flex flex-col gap-3">
      <p class="text-muted-foreground text-sm">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {author && <span> · {author}</span>}
      </p>
      <h1 class="text-foreground font-heading text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        {title}
      </h1>
      {description && <p class="text-muted-foreground text-lg text-pretty">{description}</p>}
    </header>

    {
      image &&
        (typeof image === "string" ? (
          <img src={image} alt="" class="bg-muted mb-8 w-full rounded-xl border" />
        ) : (
          <Image src={image} alt="" class="bg-muted mb-8 w-full rounded-xl border" />
        ))
    }

    <div
      class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-heading prose-headings:text-foreground prose-a:text-primary"
    >
      <slot />
    </div>
  </article>
</Layout>
